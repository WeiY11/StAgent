# =============================================================================
# StAgent — Docker Compose environment (SQLite by default; optional PostgreSQL)
# =============================================================================
# Copy to .env and adjust:
#   cp .env.example .env
#
# From this directory:
#   docker compose up -d --build
# Or:  ./run_docker.sh init && ./run_docker.sh up
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------
# Application secret (signed URLs, session crypto). Generate:
#   openssl rand -hex 32
StAgent_SECRET_KEY=changeme-generate-with-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# Compose / runtime
# -----------------------------------------------------------------------------
StAgent_VERSION=latest
# Host port published for the API (inside container StAgent_PORT stays 8000)
StAgent_HOST_PORT=8000
# Prefer localhost-only publish for Docker (override to 0.0.0.0 via compose if needed)
# Compose default below binds 127.0.0.1 — see docker-compose.yml
# Gunicorn workers — keep 1 for SQLite (single writer). Use PostgreSQL before
# raising this above 1.
StAgent_WORKERS=1
StAgent_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Security control plane
# -----------------------------------------------------------------------------
# Auth auto-enforces on non-loopback binds. Force with:
# StAgent_SECURITY_ENFORCE_AUTH=true
# StAgent_SECURITY_RATE_LIMIT_ENABLED=true
# StAgent_SECURITY_CORS_ALLOW_ORIGINS=http://127.0.0.1:5173
# StAgent_SECURITY_MAX_CONCURRENT_PER_USER=5
# Optional: override the Python executable used by code_execution and uv installs.
# StAgent_BACKEND_PYTHON=/opt/venv/bin/python

# -----------------------------------------------------------------------------
# LLM (configure at least one provider for chat)
# -----------------------------------------------------------------------------
# On first startup, detected API keys are auto-imported into providers.yaml,
# which becomes the primary configuration store.  Manage providers via the
# Admin UI after initial setup.
#
# If chat fails with "ConnectError: All connection attempts failed" while a
# system proxy (ALL_PROXY / HTTP_PROXY) is set but not running, set:
# LLM_HTTPX_TRUST_ENV=never
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_ENABLE_THINKING=true
# DASHSCOPE_ENABLE_SEARCH=false
#
# vLLM remote or local deployment (OpenAI-compatible /v1 endpoint).
# Example remote DeepSeek vLLM:
# VLLM_ENDPOINT=http://192.168.232.22:8001/v1
# VLLM_MODEL=deepseek
# VLLM_API_KEY=<remote-vllm-api-key>
#
# Leave VLLM_MODEL empty to auto-detect the first model from /v1/models.
# For the optional local GPU overlay, set VLLM_MODEL and run:
#   docker compose -f docker-compose.yml -f docker-compose.vllm.yml up -d --build
# VLLM_ENDPOINT=http://host.docker.internal:9000/v1
# VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# VLLM_API_KEY=
# VLLM_TIMEOUT=120
# VLLM_VERSION=latest
# VLLM_HOST_PORT=9000
# VLLM_TOOL_CALL_PARSER=llama3_json
# Set true when vLLM is started with --enable-auto-tool-choice (see docker-compose.vllm.yml).
# VLLM_ENABLE_AUTO_TOOL_CHOICE=true
# HUGGING_FACE_HUB_TOKEN=
#
# Ollama local inference (register as named provider "ollama"; set default_provider in providers.yaml).
# LLM_OLLAMA_ENDPOINT=http://localhost:11434
# LLM_OLLAMA_MODEL=llama3.2
# Enable thinking in providers.yaml metadata: thinking: true (maps to Ollama think parameter).

# -----------------------------------------------------------------------------
# Optional: database
# Default is SQLite at /app/data/StAgent.db when StAgent_HOME=/app/data.
# For PostgreSQL, set DATABASE_URL and keep StAgent_MIGRATIONS_REQUIRED=true so
# startup fails instead of silently serving an unmigrated schema.
# -----------------------------------------------------------------------------
# DB_SQLITE_PATH=/app/data/StAgent.db
# DATABASE_URL=postgresql+asyncpg://StAgent:change-me@postgres.example.com:5432/StAgent
# Legacy alias still supported:
# DB_DATABASE_URL=postgresql+asyncpg://StAgent:change-me@postgres.example.com:5432/StAgent
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# StAgent_RUN_MIGRATIONS=true
# StAgent_MIGRATIONS_REQUIRED=true

# -----------------------------------------------------------------------------
# Optional: web search / fetch
# -----------------------------------------------------------------------------
# WEB_SEARCH_PROVIDER=tavily
# (default tavily when WEB_SEARCH_TAVILY_API_KEY is set; without the key falls back
#  to bing_playwright via Playwright Chromium. auto → Tavily first among configured APIs.)
# WEB_SEARCH_TAVILY_API_KEY=
# WEB_SEARCH_SEARXNG_BASE_URL=http://localhost:8888
# WEB_SEARCH_BING_API_KEY=
# WEB_SEARCH_BRAVE_API_KEY=
# WEB_SEARCH_EXA_API_KEY=
# WEB_SEARCH_FIRECRAWL_API_KEY=
# WEB_SEARCH_FIRECRAWL_API_URL=
# WEB_SEARCH_SERPER_API_KEY=
# WEB_FETCH_ENABLED=1
# WEB_FETCH_CHECK_ROBOTS=1
# WEB_FETCH_CACHE_TTL_MINUTES=15

# -----------------------------------------------------------------------------
# Optional: CJK fonts for PDF / matplotlib in code_execution
# -----------------------------------------------------------------------------
# StAgent_CJK_FONT=/usr/share/fonts/opentype/noto/NotoSansSC-Regular.otf

# -----------------------------------------------------------------------------
# Agent running traces (debug / eval / model comparison)
# -----------------------------------------------------------------------------
# StAgent_TRACE__ENABLED=true
# StAgent_TRACE__CAPTURE_PAYLOADS=false
# StAgent_TRACE__RECORD_PREVIEWS=false
# StAgent_TRACE__PREVIEW_CHARS=512
# StAgent_TRACE__FLUSH_INTERVAL_MS=50
# StAgent_TRACE__RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Weixin (personal WeChat / iLink Bot) — prefer `StAgent channels login weixin`
# -----------------------------------------------------------------------------
# WEIXIN_ACCOUNT_ID=
# WEIXIN_TOKEN=
# WEIXIN_CHANNEL_ENABLED=1
# WEIXIN_DM_POLICY=open
# WEIXIN_GROUP_POLICY=disabled
# WEIXIN_ALLOWED_USERS=
# WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com

# -----------------------------------------------------------------------------
# Process-local application cache (default)
#
# Every value below tunes the in-memory CacheService. It is process-local and
# non-durable: a restart empties it and correctness is unaffected because the
# database + file layer are the only source of truth.
# -----------------------------------------------------------------------------
# StAgent_CACHE_DEFAULT_TTL=3600
# StAgent_CACHE_MAX_ITEMS=10000
# StAgent_CACHE_MAX_VALUE_BYTES=1048576
# StAgent_CACHE_SHARD_COUNT=1
# StAgent_CACHE_MAINTENANCE_INTERVAL_SEC=30
# StAgent_CACHE_TTL_JITTER_RATIO=0.05
# JSON map; mutable recall is short, stable embeddings are longer-lived.
# StAgent_CACHE_NAMESPACE_TTLS={"embeddings":7200,"recall":300,"files":1800,"chat":900,"memory":1800,"workflow_node_output":900,"webhooks":600,"variables":1800}

# -----------------------------------------------------------------------------
# Optional: shared Redis runtime (required for workers > 1)
# -----------------------------------------------------------------------------
# Install the backend production extra outside Docker: uv sync --extra production
# StAgent_REDIS_ENABLED=false
# StAgent_REDIS_URL=redis://redis.example.com:6379/0
# StAgent_REDIS_PREFIX=StAgent
# StAgent_REDIS_RUN_STORE_TTL_SECONDS=21600

# -----------------------------------------------------------------------------
# Optional: S3 / MinIO managed-file storage
# -----------------------------------------------------------------------------
# Empty endpoint uses the AWS S3 endpoint selected by region/credentials.
# Leave credentials empty when the runtime uses IAM or workload identity.
# StAgent_OBJECT_STORAGE_ENABLED=false
# StAgent_OBJECT_STORAGE_ENDPOINT_URL=https://minio.example.com
# StAgent_OBJECT_STORAGE_REGION_NAME=us-east-1
# StAgent_OBJECT_STORAGE_BUCKET=StAgent-files
# StAgent_OBJECT_STORAGE_PREFIX=StAgent
# StAgent_OBJECT_STORAGE_ACCESS_KEY_ID=
# StAgent_OBJECT_STORAGE_SECRET_ACCESS_KEY=
# StAgent_OBJECT_STORAGE_SESSION_TOKEN=

# -----------------------------------------------------------------------------
# Optional: remote RAG quality profile
# -----------------------------------------------------------------------------
# The production extra includes the Redis, S3, and PyMilvus client libraries.
# Keep every remote endpoint empty until its authenticated smoke test passes.
# Keep API keys and Milvus tokens in a secret manager outside local development.
# StAgent_KNOWLEDGE_INDEX_VERSION=rag-v1
# StAgent_KNOWLEDGE_OPENSEARCH_URL=
# StAgent_KNOWLEDGE_OPENSEARCH_INDEX=knowledge_chunks
# StAgent_KNOWLEDGE_OPENSEARCH_API_KEY=
# StAgent_KNOWLEDGE_OPENSEARCH_TIMEOUT_SECONDS=5
# StAgent_KNOWLEDGE_MILVUS_ENABLED=false
# StAgent_KNOWLEDGE_MILVUS_HOST=localhost
# StAgent_KNOWLEDGE_MILVUS_PORT=19530
# StAgent_KNOWLEDGE_MILVUS_URI=
# StAgent_KNOWLEDGE_MILVUS_TOKEN=
# Milvus is wired only when both it and an explicit embedding route are enabled.
# DeepSeek is not an embedding provider. Configure a provider/model that
# advertises embedding support before setting these values to true.
# StAgent_KNOWLEDGE_EMBEDDING_ENABLED=false
# StAgent_KNOWLEDGE_EMBEDDING_PROVIDER=ollama
# StAgent_KNOWLEDGE_EMBEDDING_MODEL=nomic-embed-text
# StAgent_KNOWLEDGE_EMBEDDING_DIMENSION=768
# Local semantic retrieval is opt-in, single-process, and never downloads a
# model implicitly. Install the RAG extra, then import or explicitly download
# a managed model from Settings → Models. The double-underscore spelling is
# equivalent to the flat spelling below; unset fields continue to use YAML.
# StAgent_KNOWLEDGE__SEMANTIC__ENABLED=false
# StAgent_KNOWLEDGE__SEMANTIC__VECTOR_BACKEND=sqlite-vec
# StAgent_KNOWLEDGE__SEMANTIC__LOCAL_MODEL_ID=
# StAgent_KNOWLEDGE__SEMANTIC__AUTO_REINDEX=true
# StAgent_KNOWLEDGE_SEMANTIC_ENABLED=false
# StAgent_KNOWLEDGE_SEMANTIC_VECTOR_BACKEND=sqlite-vec
# StAgent_KNOWLEDGE_SEMANTIC_LOCAL_MODEL_ID=
# StAgent_KNOWLEDGE_SEMANTIC_AUTO_REINDEX=true
# StAgent_KNOWLEDGE_RERANK_ENDPOINT=
# StAgent_KNOWLEDGE_RERANK_API_KEY=
# StAgent_KNOWLEDGE_RERANK_TIMEOUT_SECONDS=5
# Enables provider-backed query rewrite before retrieval. When the configured
# fast route is DeepSeek, StAgent disables thinking for this bounded JSON call.
# DeepSeek supplies rewrite/answer generation only. A Milvus deployment stays
# on lexical retrieval unless its explicit embedding provider/model is ready.
# StAgent_KNOWLEDGE_QUERY_REWRITE_ENABLED=false
# StAgent_KNOWLEDGE_STRICT_EVIDENCE=true
# StAgent_KNOWLEDGE_MAX_CONTEXT_TOKENS=6000
# StAgent_KNOWLEDGE_RECALL_AT_10_TARGET=0.90
# StAgent_KNOWLEDGE_NDCG_AT_10_TARGET=0.80
# StAgent_KNOWLEDGE_CITATION_ACCURACY_TARGET=0.95
# StAgent_KNOWLEDGE_HALLUCINATION_RATE_MAX=0.02
# StAgent_KNOWLEDGE_RETRIEVAL_P95_MS_TARGET=5000
